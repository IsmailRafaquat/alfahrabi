      "folder": "src"
    },
    "EHub.Application.Contracts": {
      "path": "src/EHub.Application.Contracts/EHub.Application.Contracts.abppkg",
      "folder": "src"
    },
    "EHub.HttpApi": {
      "path": "src/EHub.HttpApi/EHub.HttpApi.abppkg",
      "folder": "src"
    },
    "EHub.HttpApi.Client": {
      "path": "src/EHub.HttpApi.Client/EHub.HttpApi.Client.abppkg",
      "folder": "src"
    },
    "EHub.EntityFrameworkCore.Tests": {
      "path": "test/EHub.EntityFrameworkCore.Tests/EHub.EntityFrameworkCore.Tests.abppkg",
      "folder": "test"
    },
    "EHub.EntityFrameworkCore": {
      "path": "src/EHub.EntityFrameworkCore/EHub.EntityFrameworkCore.abppkg",
      "folder": "src"
    },
    "EHub.TestBase": {
      "path": "test/EHub.TestBase/EHub.TestBase.abppkg",
